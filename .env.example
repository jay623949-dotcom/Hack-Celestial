# ==================================================
# RESORT 360 - ENVIRONMENT VARIABLES TEMPLATE
# ==================================================
# Copy this file to .env (or backend/.env and frontend/.env.local)
# DO NOT COMMIT REAL VALUES OR SECRETS TO GIT.

# --------------------------------------------------
# Frontend Variables (Next.js)
# --------------------------------------------------
# Accessible in the browser via NEXT_PUBLIC_ prefix
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# --------------------------------------------------
# Backend Variables (Express.js)
# --------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --------------------------------------------------
# Database (PostgreSQL / Supabase)
# --------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/resort360
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------
# AI / LLM Layer
# --------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
