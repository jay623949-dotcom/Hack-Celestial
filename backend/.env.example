# ==============================================================================
# Resort 360 — Backend Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port (Render sets this dynamically in production)
PORT=5000

# PostgreSQL Database Connection URL
# Local: postgres://postgres:password@localhost:5432/resort360
# Render: postgres://user:password@dpg-...-a.oregon-postgres.render.com/resort360
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resort360

# Database SSL Setting (auto-detected on Render, set 'true' or 'false' to override)
DATABASE_SSL=false

# Allowed Frontend URL for CORS & Socket.IO
# Local: http://localhost:3000
# Production: https://your-resort360.vercel.app
FRONTEND_URL=http://localhost:3000

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Grok (xAI) API Key (Backend-only — NEVER expose to browser)
XAI_API_KEY=your_xai_api_key_here

# AI Routing Configuration
AI_PROVIDER=grok
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# Local LLM Fallback (Optional — Ollama / Gemma 2)
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma2:2b

# Telegram Autonomous Operations Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORITY_CHAT_ID=
