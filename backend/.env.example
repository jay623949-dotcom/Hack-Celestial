# ==================================================
# RESORT 360 - BACKEND ENVIRONMENT VARIABLES
# ==================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resort360
# ==================================================
# AI MODEL CONFIGURATION (Universal Adapter)
# Providers: 'nugen' (Domain-Aligned) | 'gemini' (Free tier) | 'openai' | 'local'
# ==================================================
AI_PROVIDER=nugen

# Nugen Intelligence (Domain-Aligned AI Platform - https://docs.nugen.in)
NUGEN_API_KEY=
NUGEN_BASE_URL=https://api.nugen.in
NUGEN_MODEL_ID=resort360-hospitality-v1
NUGEN_ALIGNMENT_ID=
NUGEN_DEPLOYMENT_ID=


# Google Gemini (Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local LLM (Ollama, LM Studio, vLLM, LocalAI)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2

# ==================================================
# TELEGRAM BOT INTEGRATION
# ==================================================
TELEGRAM_BOT_TOKEN=

